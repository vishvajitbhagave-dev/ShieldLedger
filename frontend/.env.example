# Copy this file to .env to override the defaults.
#
# Network the DApp targets. For the local docker compose devnet use
# "undeployed" (matches the indexer's APP__APPLICATION__NETWORK_ID).
# For a public network: "preview" or "preprod".
VITE_NETWORK_ID=undeployed

# Optional overrides for provider endpoints. When unset the DApp uses the
# URLs the connected wallet reports via getConfiguration().
#
# Local devnet behind the Vite proxy (see vite.config.ts):
#   VITE_INDEXER_URL=http://localhost:5173/indexer/api/v4/graphql
#   VITE_INDEXER_WS_URL=ws://localhost:5173/indexer/api/v4/graphql/ws
#   VITE_PROOF_SERVER_URL=http://localhost:5173/proof-server
#
# Public network example:
#   VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
#   VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
#   VITE_PROOF_SERVER_URL=http://localhost:6300
#VITE_INDEXER_URL=
#VITE_INDEXER_WS_URL=
#VITE_PROOF_SERVER_URL=

# --- Observability (all optional; leave unset for a clean no-op build) ---
#
# Error monitoring (Sentry). When set, unhandled errors and failed on-chain
# actions are reported with the network as the environment and the commit SHA
# (or "dev") as the release. See docs/monitoring.md.
#VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
#
# Privacy-friendly analytics (Plausible-compatible endpoint). Set the site id
# registered upstream; optionally override the ingest endpoint for self-hosting.
# Page views, key actions and Core Web Vitals are reported. No-op when unset.
#VITE_ANALYTICS_DOMAIN=shieldledger.example.com
#VITE_ANALYTICS_ENDPOINT=https://plausible.io/api/event
#
# Release tag attached to error reports (normally injected by the Pages CD
# workflow as the git SHA; set manually for local prod-like builds).
#VITE_APP_RELEASE=local
