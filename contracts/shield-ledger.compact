// ShieldLedger — confidential invoice-financing on the Midnight Network.
//
// ─────────────────────────────────────────────────────────────────────────────
//  PUBLIC vs PRIVATE SPLIT
// ─────────────────────────────────────────────────────────────────────────────
//  PUBLIC (disclosed to the ledger, verifiable by anyone):
//    • invoices      — Map<Bytes<32>, Invoice>: a registry of *nullifiers*
//                       (opaque 32-byte hashes of invoices, e.g. the
//                       hash of invoice id + issue date) plus, once
//                       financed, a public receipt (winning lender
//                       pseudonym, financed amount, financed due date,
//                       winning interest rate). Each invoice also carries a
//                       public buyer-verification flag ("buyer verified:
//                       true/false") and the SME's *claimed* face amount,
//                       so a corporate buyer can cryptographically vouch
//                       for the invoice. Invoice contents themselves
//                       stay private.
//    • bids          — Map<Bytes<32>, SealedBid>: one *sealed* bid per
//                       (invoice, lender) pair, keyed by a derived bid key
//                       (hash of nullifier + lender pseudonym). Only the
//                       lender's pseudonym and a *commitment* to the bid
//                       terms are stored — the interest rate, amount and
//                       due date never touch the ledger until the bidder
//                       reveals them. Lenders cannot see each other's bids.
//    • bestBids      — Map<Bytes<32>, BestBid>: the running best bid per
//                       invoice. Ties are broken by whole-invoice-first priority
//                       (willingToSplit=false beats willingToSplit=true regardless
//                       of rate), then lowest interest rate, then smallest amount,
//                       then earliest due date, then first revealer.
//                       reveal, so it cannot be spoofed or front-run by a
//                       non-bidder. Settlement is bound to this entry, so the
//                       SME cannot favor an arbitrary lender.
//    • insurancePools — Map<Bytes<32>, InsurancePool>: ONE shared aggregate
//                       default-insurance balance, stored under a fixed
//                       domain-separated key. Every registration credits it
//                       with 2% of the invoice's face amount; every paid
//                       default claim debits it. Observers see only the
//                       running balance — never which SME funded it or why a
//                       specific payout happened.
//    • insuranceClaims— Map<Bytes<32>, InsuranceClaim>: one entry per PAID
//                       default-insurance claim, keyed by the (already
//                       public) invoice nullifier. Makes every claim
//                       single-use and reveals nothing beyond what the
//                       auction itself already published.
//    • invoiceCount  — Counter: number of ledger transitions, for UI/replay.
//
//  SECONDARY MARKET (claim resale before settlement):
//    transferClaim(nullifier, newOwnerCommitment) — the current claim holder
//       privately resells their claim to another investor. The ledger sees
//       only an opaque commitment to the new owner and a boolean
//       `transferred` flag; neither party's identity nor any transfer
//       history is ever stored. At settlement an invoice whose claim changed
//       hands records an opaque "secondary" payee marker instead of the
//       original winner's pseudonym; the current holder proves their right
//       to the payout in ZK against the stored claimCommitment.
//
//  PRIVATE (never leaves the proposer's wallet, never disclosed):
//    • Invoice contents: buyer identity, line items, counterparties — only
//      the nullifier hash and the SME's commitment (a hash of the SME
//      secret + nullifier) touch the ledger.
//    • SME secret (witness smeSecret) — proves SME ownership of an invoice
//      via deriveCommitment without revealing the secret.
//    • Lender secret (witness lenderSecret) — pseudonymous bidding; a lender
//      proves "I own bid X" (used for settlement) without revealing identity.
//      It also seals the bid: the stored commitment is a hash of the terms
//      plus this secret, so only the bidder can reveal a matching bid.
//    • lenderCreditScore  — a private, verifier-checked credential: the
//      circuit asserts score >= 700 without ever disclosing the score.
//    • smeCreditScore     — the SME's private credit score (CIBIL-style). At
//      registration the SME proves "my score is above X" (X = the chosen
//      threshold) entirely in zero knowledge; only the threshold itself — a
//      public *attestation* of the bound — is stored. The exact score, and
//      the whole financial history behind it, never touch the ledger.
//    • smeReputationScore  — the SME's private cross-deal reputation score
//      (0..100) accumulated across every invoice the SME has ever settled:
//      on-time settlements +10 (capped at 100), late/defaulted ones -20
//      (floored at 0). The score and the deal history behind it stay in the
//      wallet; only the *proven bound* (reputationThreshold) is disclosed.
//    • smeOnTimeCount / smeLateCount — private counts of on-time vs
//      late/defaulted settlements, shown only on the SME's own dashboard.
//    • lenderMinReputation — a private per-lender minimum reputation bar. At
//      submitBid the circuit requires the invoice's PUBLIC reputation
//      threshold to meet it, so lenders can filter low-reputation invoices
//      without ever disclosing their bar or any SME's raw score.
//    • lenderExposureCap  — a private lending limit: bids are rejected
//      circuit-side when they would exceed the cap.
//    • buyerSecret      — the corporate buyer's private secret. At
//      confirmation the buyer proves knowledge of this secret for the given
//      invoice nullifier, so the confirmation is bound to the specific
//      invoice and cannot be reused or forged for another one. The buyer's
//      identity, its other supplier relationships, and the full contract
//      terms never touch the ledger — only an opaque per-invoice
//      buyerCommitment and the boolean flag do.
//
//  AUCTION FLOW (sealed-bid, lowest rate wins):
//    1. registerInvoice(nullifier, creditThreshold, invoiceAmount) — SME lists
//       the invoice (BIDDING), proving score >= creditThreshold in ZK; the
//       threshold is the only credit data revealed, and the *claimed* face
//       amount becomes public so the buyer can vouch for it.
//       A second public bound, reputationThreshold, attests "my cross-deal
//       reputation score is at least this" in ZK; 0 means no requirement.
//    2. confirmInvoice(nullifier, confirmedAmount) — the corporate buyer
//       proves it acknowledges owing exactly the claimed amount for this
//       invoice (a mismatch fails in-circuit). Only a boolean
//       buyerVerified flag and an opaque per-invoice commitment become
//       public; the buyer's identity and terms stay private.
//    3. submitBid(nullifier, commitment)— each lender posts a *seal*; no
//       other lender can read their terms. Lenders see the buyer-verification
//       status before bidding.
//    4. revealBid(nullifier, amt, due, rateBps, willingToSplit) — a lender
//       proves ownership of their seal and, if their bid beats the running best,
//       becomes the leading bid. Whole-invoice bids (willingToSplit=false) always
//       beat split bids (willingToSplit=true) regardless of rate. Within the same
//       group the best rate wins, then smallest amount, then earliest due date.
//    5. settleInvoice(nullifier, amt, due) — SME proves ownership and the
//       contract pays the *best* bid only; the SME cannot choose a loser.
//       Also takes settledAt and returns settledAt <= due so the wallet can
//       classify the settlement on-time/late for the private reputation score.
//    6. claimInsurancePayout(nullifier, ...) — once a financed invoice is
//       past its due date and still unsettled, the CURRENT claim holder
//       proves their right in ZK (same authorization as settlement/transfer)
//       and collects 50% of the financed amount from the shared insurance
//       pool — partially, if the pool cannot cover it in full. The pool was
//       funded at step 1 by 2% premiums; the defaulting SME's identity never
//       becomes public.
// ─────────────────────────────────────────────────────────────────────────────

pragma language_version 0.23;
import CompactStandardLibrary;

// Minimum credit threshold a "score >= X" claim may assert. Prevents the SME
// from "proving" score >= 0, which would be meaningless. (Compact has no
// top-level constants yet, so the floor is inlined below and mirrored as
// MIN_CREDIT_SCORE in tests/shield-ledger-simulator.ts.)
export enum InvoiceStatus { BIDDING, FINANCED }

export struct Invoice {
  smeCommitment: Bytes<32>,
  creditThreshold: Uint<64>,
  reputationThreshold: Uint<64>,
  invoiceAmount: Uint<64>,
  buyerVerified: Boolean,
  buyerCommitment: Bytes<32>,
  lender: Maybe<Bytes<32>>,
  amount: Uint<64>,
  dueDate: Uint<64>,
  rateBps: Uint<64>,
  // Secondary market: commitment to the CURRENT claim holder
  // (hash of ClaimSeal{nullifier, holderSecret}). While the auction is open it
  // is the "no claim" placeholder; the winning lender seeds it with their own
  // commitment on the first transferClaim. Observers see only this opaque
  // value change — never who holds (or held) the claim.
  claimCommitment: Bytes<32>,
  // Selective disclosure: true once at least one ownership transfer happened.
  // No transfer history, count, or party identity is ever stored.
  transferred: Boolean,
  // Pool financing: 0 = single-lender (default), N = pool of N lenders.
  // Set at registration; used by settleSplitInvoice to distinguish settlement paths.
  splitCount: Uint<64>,
}

// Domain-separated seal binding a claim-holder secret to ONE invoice
// nullifier, so a claim commitment can never be replayed onto another invoice.
export struct ClaimSeal {
  nullifier: Bytes<32>,
  secret: Bytes<32>,
}

export struct SealedBid {
  nullifier: Bytes<32>,
  lender: Bytes<32>,
  commitment: Bytes<32>,
}

export struct BestBid {
  lender: Bytes<32>,
  amount: Uint<64>,
  dueDate: Uint<64>,
  rateBps: Uint<64>,
  willingToSplit: Boolean,
}

export struct BidSeal {
  nullifier: Bytes<32>,
  amount: Uint<64>,
  dueDate: Uint<64>,
  rateBps: Uint<64>,
  secret: Bytes<32>,
  willingToSplit: Boolean,
}

// ─── Pool financing (multi-investor split) ────────────────────────────────────

// One entry per lender slot in a pool-financed invoice. The lender's
// contribution amount is a PRIVATE witness — never written to the ledger.
// Only the pseudonym (needed for payout routing) and the sealed commitment
// (needed for reveal verification) are public.
export struct PoolBid {
  lender: Bytes<32>,
  commitment: Bytes<32>,
}

// Aggregate default-insurance pool state. Stored as a single-entry map keyed
// by insurancePoolKey() because Compact cannot assign arithmetic results back
// to scalar ledgers (Uint bounds widen through + and -). Transitions instead
// pass the NEW balance as a public argument and prove, inside the circuit,
// that it equals the previous balance plus/minus the transition amount.
export struct InsurancePool {
  balance: Uint<64>,
}

// Hash input for per-lender payout commitments. The settlement circuit
// computes persistentHash<PayoutSeal> for each slot and stores the result
// in payoutCommitments. This binds the payout value to the slot without
// revealing it on-chain — the hash is the only thing stored.
export struct PayoutSeal {
  slotKey: Bytes<32>,
  payout: Uint<64>,
}

// Per-lender payout commitment for pool-financed invoices. One entry per
// lender slot, keyed by poolSlotKey(nullifier, slotIndex). Stores only the
// hash commitment — the actual payout amount stays private. At insurance
// claim time, the claimant must provide values that hash to this commitment.
export struct PayoutCommitment {
  hash: Bytes<32>,
}

// A paid default-insurance claim. Keyed by the invoice nullifier (already
// public), so presence alone blocks a second payout for the same default.
export struct InsuranceClaim {
  payout: Uint<64>,
  claimedAt: Uint<64>,
}

// Per-lender claim ownership for pool-financed invoices. Stored under the
// same poolSlotKey as PayoutCommitment, so each lender slot has exactly one
// claim commitment. Transfers mirror the single-lender secondary market:
// the winning lender seeds it on first hand-over; later transfers prove the
// stored claimCommitment via claimSecret.
export struct PoolClaim {
  claimCommitment: Bytes<32>,
  transferred: Boolean,
}

export ledger invoices: Map<Bytes<32>, Invoice>;
export ledger bids: Map<Bytes<32>, SealedBid>;
export ledger bestBids: Map<Bytes<32>, BestBid>;
export ledger bestPools: Map<Bytes<32>, PoolBid>;
export ledger payoutCommitments: Map<Bytes<32>, PayoutCommitment>;
export ledger insurancePools: Map<Bytes<32>, InsurancePool>;
export ledger insuranceClaims: Map<Bytes<32>, InsuranceClaim>;
export ledger poolClaimCommitments: Map<Bytes<32>, PoolClaim>;
export ledger invoiceCount: Counter;

witness smeSecret(): Bytes<32>;
witness smeCreditScore(): Uint<64>;
witness lenderSecret(): Bytes<32>;
witness lenderCreditScore(): Uint<64>;
witness lenderExposureCap(): Uint<64>;
witness buyerSecret(): Bytes<32>;
witness smeReputationScore(): Uint<64>;
witness lenderMinReputation(): Uint<64>;
// Secondary market: the CURRENT claim holder's private secret. Only read by
// transferClaim (and only after the first hand-over) — the winning lender
// authorizes their own first transfer via lenderSecret instead.
witness claimSecret(): Bytes<32>;

// Lists the invoice. The SME proves score >= creditThreshold in zero knowledge
// (the exact score never leaves the wallet); only the proven threshold is
// disclosed, so lenders can see "credit-checked: score >= 650" without ever
// learning the score. creditThreshold is public, but it is a *bound* — the
// attestation the SME chose to reveal, gated by the contract's floor. The
// claimed face amount (invoiceAmount) is also public: it is the amount a
// corporate buyer must later vouch for, and the amount lenders will finance.
// reputationThreshold is a second *bound*: it attests that the SME's private
// cross-deal reputation score is >= that value (0 = no requirement). Only the
// bound is stored; the raw score and the on-time/late history stay private.
//
// Default insurance: every registration pays a premium of exactly 2% of the
// face amount (floored) into the shared public pool. The SME discloses the
// premium and the resulting pool balance; the circuit PROVES both are correct
// (premium == floor(invoiceAmount / 50) via verifyUnitQuotient, balance
// transition via an equality against the on-chain value) rather than trusting
// them. The first registration seeds the pool entry.
export circuit registerInvoice(nullifier: Bytes<32>, creditThreshold: Uint<64>, invoiceAmount: Uint<64>, reputationThreshold: Uint<64>, insuranceContribution: Uint<64>, newPoolBalance: Uint<64>, splitCount: Uint<64>): [] {
  assert(!invoices.member(disclose(nullifier)), "invoice already registered");
  assert(disclose(creditThreshold) >= 650, "threshold below minimum");
  assert(smeCreditScore() >= disclose(creditThreshold), "not creditworthy");
  assert(smeReputationScore() >= disclose(reputationThreshold), "insufficient reputation");
  assert(disclose(splitCount) <= 4, "split count exceeds maximum");
  const commitment = disclose(deriveCommitment(smeSecret(), disclose(nullifier)));
  invoices.insert(disclose(nullifier), Invoice { smeCommitment: commitment, creditThreshold: disclose(creditThreshold), reputationThreshold: disclose(reputationThreshold), invoiceAmount: disclose(invoiceAmount), buyerVerified: false, buyerCommitment: pad(32, "shieldledger:unverified"), lender: none<Bytes<32>>(), amount: 0, dueDate: 0, rateBps: 0, claimCommitment: pad(32, "shieldledger:noclaim"), transferred: false, splitCount: disclose(splitCount) });
  // Insurance premium accrual — see comment above.
  const premiumOk = verifyUnitQuotient(disclose(invoiceAmount), disclose(insuranceContribution), 50);
  const poolKey = insurancePoolKey();
  if (insurancePools.member(poolKey)) {
    const pool = insurancePools.lookup(poolKey);
    assert(pool.balance + disclose(insuranceContribution) == disclose(newPoolBalance), "pool balance mismatch");
    insurancePools.insert(poolKey, InsurancePool { balance: disclose(newPoolBalance) });
  } else {
    // First registration seeds the pool; the disclosed balance must equal
    // exactly this first premium (from a zero starting balance).
    assert(disclose(newPoolBalance) == disclose(insuranceContribution), "pool balance mismatch");
    insurancePools.insert(poolKey, InsurancePool { balance: disclose(insuranceContribution) });
  }
  invoiceCount.increment(1);
}

// Buyer confirmation: the corporate buyer proves it acknowledges owing exactly
// the claimed amount for this specific invoice. Knowledge of buyerSecret is
// proven by disclosing deriveBuyerCommitment(buyerSecret, nullifier), so the
// confirmation is bound to the nullifier and cannot be forged or replayed for
// another invoice. Only the boolean flag and the opaque per-invoice commitment
// become public — the buyer's identity, other supplier relationships and the
// full contract terms never touch the ledger. An amount that differs from the
// SME's claim fails the assert inside the circuit (not application logic).
export circuit confirmInvoice(nullifier: Bytes<32>, confirmedAmount: Uint<64>): [] {
  assert(invoices.member(disclose(nullifier)), "unknown invoice");
  assert(!invoices.lookup(disclose(nullifier)).lender.is_some, "invoice not in bidding");
  assert(!invoices.lookup(disclose(nullifier)).buyerVerified, "already buyer verified");
  assert(disclose(confirmedAmount) == invoices.lookup(disclose(nullifier)).invoiceAmount, "amount mismatch");
  const current = invoices.lookup(disclose(nullifier));
  const buyerCommitment = disclose(deriveBuyerCommitment(buyerSecret(), disclose(nullifier)));
  invoices.insert(disclose(nullifier), Invoice { smeCommitment: current.smeCommitment, creditThreshold: current.creditThreshold, reputationThreshold: current.reputationThreshold, invoiceAmount: current.invoiceAmount, buyerVerified: true, buyerCommitment: buyerCommitment, lender: current.lender, amount: current.amount, dueDate: current.dueDate, rateBps: current.rateBps, claimCommitment: current.claimCommitment, transferred: current.transferred, splitCount: current.splitCount });
  invoiceCount.increment(1);
}

// Sealed bidding: only a commitment to the terms (amount, due date, interest
// rate) touches the ledger, so no lender can see any other bid. The credit
// score is enforced here (identity is not), the exposure cap at reveal (the
// amount is unknown until then). A lender may also require a private minimum
// reputation (lenderMinReputation): the invoice's PUBLIC reputationThreshold
// must clear it, or the bid is rejected in-circuit.
export circuit submitBid(nullifier: Bytes<32>, commitment: Bytes<32>): [] {
  assert(lenderCreditScore() >= 700, "not creditworthy");
  assert(invoices.member(disclose(nullifier)), "unknown invoice");
  assert(!invoices.lookup(disclose(nullifier)).lender.is_some, "invoice not in bidding");
  assert(invoices.lookup(disclose(nullifier)).reputationThreshold >= lenderMinReputation(), "reputation below lender minimum");
  const pseudonym = disclose(derivePseudonym(lenderSecret()));
  const bidKey = disclose(deriveBidKey(disclose(nullifier), pseudonym));
  assert(!bids.member(bidKey), "already bid");
  bids.insert(bidKey, SealedBid { nullifier: disclose(nullifier), lender: pseudonym, commitment: disclose(commitment) });
  invoiceCount.increment(1);
}

// Reveal: the bidder re-derives the commitment from the private lender secret
// and the disclosed terms, proves it matches the stored seal, and — if it
// beats the current best — becomes the running best. "Beats" is determined by
// whole-invoice-first priority: a whole bid (willingToSplit=false) always wins
// over a split bid (willingToSplit=true) regardless of rate. Within the same
// group the comparison is: lowest interest rate, then smallest amount, then
// earliest due date. Ties within a group keep the first revealer in the lead.
// Only a genuine bidder can update the best bid, and settlement is bound to it.
export circuit revealBid(nullifier: Bytes<32>, amount: Uint<64>, dueDate: Uint<64>, rateBps: Uint<64>, willingToSplit: Boolean): [] {
  assert(lenderCreditScore() >= 700, "not creditworthy");
  assert(disclose(amount) <= lenderExposureCap(), "bid exceeds exposure cap");
  assert(invoices.member(disclose(nullifier)), "unknown invoice");
  assert(!invoices.lookup(disclose(nullifier)).lender.is_some, "invoice not in bidding");
  const pseudonym = disclose(derivePseudonym(lenderSecret()));
  const bidKey = disclose(deriveBidKey(disclose(nullifier), pseudonym));
  assert(bids.member(bidKey), "no such bid");
  const seal = bids.lookup(bidKey);
  assert(seal.commitment == deriveBidCommitment(lenderSecret(), disclose(nullifier), disclose(amount), disclose(dueDate), disclose(rateBps), disclose(willingToSplit)), "commitment mismatch");
  const candidate = BestBid { lender: pseudonym, amount: disclose(amount), dueDate: disclose(dueDate), rateBps: disclose(rateBps), willingToSplit: disclose(willingToSplit) };
  if (bestBids.member(disclose(nullifier))) {
    const current = bestBids.lookup(disclose(nullifier));
    if (isBetter(disclose(rateBps), disclose(amount), disclose(dueDate), current.rateBps, current.amount, current.dueDate, disclose(willingToSplit), current.willingToSplit)) {
      bestBids.insert(disclose(nullifier), candidate);
    }
  } else {
    bestBids.insert(disclose(nullifier), candidate);
  }
  invoiceCount.increment(1);
}

export circuit settleInvoice(nullifier: Bytes<32>, financedAmount: Uint<64>, financedDueDate: Uint<64>, settledAt: Uint<64>): Boolean {
  assert(invoices.member(disclose(nullifier)), "unknown invoice");
  assert(deriveCommitment(smeSecret(), disclose(nullifier)) == invoices.lookup(disclose(nullifier)).smeCommitment, "not the SME");
  assert(!invoices.lookup(disclose(nullifier)).lender.is_some, "already financed");
  assert(bestBids.member(disclose(nullifier)), "auction not resolved");
  const best = bestBids.lookup(disclose(nullifier));
  assert(disclose(financedAmount) <= best.amount, "amount exceeds winning bid");
  // Payout routing follows the CURRENT claim holder: if the claim was traded
  // on the secondary market, the receipt records an opaque
  // "paid via secondary market" marker instead of the original winning-lender
  // pseudonym — the SME pays whoever holds the claim commitment, and the
  // ledger learns neither the holder's identity nor the transfer history.
  // The invoice keeps the latest claimCommitment, so the current holder can
  // always prove (in ZK) their right to the payout.
  const current = invoices.lookup(disclose(nullifier));
  const receiptLender = pickPayee(current.transferred, disclose(best.lender));
  const receiptAmount = disclose(financedAmount);
  const receiptDueDate = disclose(financedDueDate);
  const receiptRate = disclose(best.rateBps);
  invoices.insert(disclose(nullifier), Invoice { smeCommitment: current.smeCommitment, creditThreshold: current.creditThreshold, reputationThreshold: current.reputationThreshold, invoiceAmount: current.invoiceAmount, buyerVerified: current.buyerVerified, buyerCommitment: current.buyerCommitment, lender: some<Bytes<32>>(receiptLender), amount: receiptAmount, dueDate: receiptDueDate, rateBps: receiptRate, claimCommitment: current.claimCommitment, transferred: current.transferred, splitCount: current.splitCount });
  invoiceCount.increment(1);
  return disclose(settledAt) <= disclose(financedDueDate);
}

// ─── Secondary market: private claim ownership transfer ──────────────────────

// The current claim-holder resells their claim to a new investor. Only an
// opaque commitment to the NEW owner touches the ledger — neither party's
// identity is disclosed and no transfer history is kept.
//
// Authorization (two phases):
//   • First hand-over (`transferred == false`): only the auction leader may
//     seed the ownership chain — proven by deriving the pseudonym from
//     lenderSecret and matching the public best-bid entry.
//   • Every later hand-over: the caller proves knowledge of the CURRENT
//     holder secret by re-deriving the stored claimCommitment in ZK.
// Because each commitment binds the invoice nullifier (ClaimSeal) and a
// successful transfer replaces it atomically, a transfer cannot be replayed,
// forged for a different invoice, or double-spent by a former owner.
export circuit transferClaim(nullifier: Bytes<32>, newOwnerCommitment: Bytes<32>): [] {
  assert(invoices.member(disclose(nullifier)), "unknown invoice");
  const invoice = invoices.lookup(disclose(nullifier));
  assert(!invoice.lender.is_some, "already settled");
  assert(bestBids.member(disclose(nullifier)), "auction not resolved");
  if (!invoice.transferred) {
    const leaderPseudonym = disclose(derivePseudonym(lenderSecret()));
    assert(leaderPseudonym == bestBids.lookup(disclose(nullifier)).lender, "not the claim holder");
  } else {
    assert(deriveClaimCommitment(claimSecret(), disclose(nullifier)) == invoice.claimCommitment, "not the claim holder");
  }
  invoices.insert(disclose(nullifier), Invoice { smeCommitment: invoice.smeCommitment, creditThreshold: invoice.creditThreshold, reputationThreshold: invoice.reputationThreshold, invoiceAmount: invoice.invoiceAmount, buyerVerified: invoice.buyerVerified, buyerCommitment: invoice.buyerCommitment, lender: invoice.lender, amount: invoice.amount, dueDate: invoice.dueDate, rateBps: invoice.rateBps, claimCommitment: disclose(newOwnerCommitment), transferred: true, splitCount: invoice.splitCount });
  invoiceCount.increment(1);
}

export circuit deriveClaimCommitment(ownerSecret: Bytes<32>, nullifier: Bytes<32>): Bytes<32> {
  return persistentHash<ClaimSeal>(ClaimSeal { nullifier, secret: ownerSecret });
}

// Opaque settlement payee for claims that changed hands on the secondary
// market. Deliberately NOT derived from anyone's secret: it is a constant,
// so it cannot be linked to any wallet or pseudonym.
export circuit deriveSecondaryPayee(): Bytes<32> {
  return pad(32, "shieldledger:secondary");
}

// Settlement payout routing: a claim that changed hands pays the CURRENT
// holder, recorded publicly only as the opaque secondary-market marker.
export circuit pickPayee(transferred: Boolean, winnerPseudonym: Bytes<32>): Bytes<32> {
  if (transferred) {
    return deriveSecondaryPayee();
  } else {
    return winnerPseudonym;
  }
}

export circuit deriveCommitment(secret: Bytes<32>, nullifier: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([nullifier, secret]);
}

export circuit deriveBuyerCommitment(secret: Bytes<32>, nullifier: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([secret, nullifier]);
}

export circuit derivePseudonym(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "shieldledger:lender"), secret]);
}

export circuit deriveBidKey(nullifier: Bytes<32>, pseudonym: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([nullifier, pseudonym]);
}

export circuit deriveBidCommitment(secret: Bytes<32>, nullifier: Bytes<32>, amount: Uint<64>, dueDate: Uint<64>, rateBps: Uint<64>, willingToSplit: Boolean): Bytes<32> {
  return persistentHash<BidSeal>(BidSeal { nullifier, amount, dueDate, rateBps, secret, willingToSplit });
}

export circuit isBetter(rate: Uint<64>, amount: Uint<64>, dueDate: Uint<64>, bestRate: Uint<64>, bestAmount: Uint<64>, bestDueDate: Uint<64>, willingToSplit: Boolean, bestWillingToSplit: Boolean): Boolean {
  // Whole-invoice bids (willingToSplit=false) always beat split bids
  // (willingToSplit=true) regardless of rate/amount/dueDate, because a
  // whole-invoice commitment is more valuable to the SME.
  if (!willingToSplit && bestWillingToSplit) {
    return true;
  }
  if (willingToSplit && !bestWillingToSplit) {
    return false;
  }
  // Same group: lowest rate → smallest amount → earliest due date → first revealer.
  return rate < bestRate
    || (rate == bestRate && amount < bestAmount)
    || (rate == bestRate && amount == bestAmount && dueDate < bestDueDate);
}

// ─── Pool financing: slot keys and reveal ─────────────────────────────────────

// Domain-separated key for a pool slot. Uses fixed string labels per slot
// index because Compact cannot serialize Uint<64> into Bytes<32> at runtime.
// The slotIndex is a public argument — the circuit knows at proof-generation
// time which slot it operates on.
export circuit poolSlotKey(nullifier: Bytes<32>, slotIndex: Uint<64>): Bytes<32> {
  if (disclose(slotIndex) == 0) {
    return persistentHash<Vector<2, Bytes<32>>>([nullifier, pad(32, "pool:slot:0")]);
  }
  if (disclose(slotIndex) == 1) {
    return persistentHash<Vector<2, Bytes<32>>>([nullifier, pad(32, "pool:slot:1")]);
  }
  if (disclose(slotIndex) == 2) {
    return persistentHash<Vector<2, Bytes<32>>>([nullifier, pad(32, "pool:slot:2")]);
  }
  return persistentHash<Vector<2, Bytes<32>>>([nullifier, pad(32, "pool:slot:3")]);
}

// Pool reveal: a lender reveals their sealed bid into an indexed pool slot.
// The invoice must have splitCount > 0 (registered as a pool invoice).
// Each slot can only be filled once. The lender's contribution amount stays
// PRIVATE — only the pseudonym and commitment are stored on-chain.
export circuit revealPoolBid(nullifier: Bytes<32>, slotIndex: Uint<64>, commitment: Bytes<32>): [] {
  assert(lenderCreditScore() >= 700, "not creditworthy");
  assert(invoices.member(disclose(nullifier)), "unknown invoice");
  assert(invoices.lookup(disclose(nullifier)).splitCount > 0, "not a pool invoice");
  assert(disclose(slotIndex) < 4, "invalid slot index");

  const pseudonym = disclose(derivePseudonym(lenderSecret()));
  const poolKey = poolSlotKey(disclose(nullifier), disclose(slotIndex));

  // The lender must have a matching sealed bid
  const bidKey = disclose(deriveBidKey(disclose(nullifier), pseudonym));
  assert(bids.member(bidKey), "no sealed bid for this lender");
  const seal = bids.lookup(bidKey);
  assert(seal.commitment == disclose(commitment), "commitment mismatch");

  // Only one reveal per slot
  assert(!bestPools.member(poolKey), "slot already filled");

  bestPools.insert(poolKey, PoolBid { lender: pseudonym, commitment: disclose(commitment) });
  invoiceCount.increment(1);
}

// ─── Pool financing: proportional payout verification and settlement ──────────

// Pure circuit: proves one lender's payout is the correct PROPORTIONAL FLOOR
// of the total payout, using only multiplication and comparison (Compact has
// no division).
//
// Formula: payout_i = floor(contribution_i * totalPayout / totalContribution)
//
// Proven via the same floor-division pattern as verifyUnitQuotient, generalized
// to arbitrary numerator/denominator:
//   1. payout * totalContribution ≤ contribution * totalPayout  (payout doesn't exceed)
//   2. contribution * totalPayout - payout * totalContribution < totalContribution  (remainder < divisor)
//
// The overflow cap (contribution_i < 2^32) is asserted FIRST, so the
// subsequent multiplications cannot overflow Uint<64>:
//   (2^32 - 1) * (2^32 - 1) = 2^64 - 2^33 + 1 < 2^64 ✓
export circuit verifyProportionalPayout(contribution: Uint<64>, payout: Uint<64>, totalContribution: Uint<64>, totalPayout: Uint<64>): Boolean {
  // Overflow cap: each contribution must be < 2^32 BEFORE any multiplication.
  assert(contribution < 4294967296, "contribution exceeds overflow cap");
  // Floor proof: payout * totalContribution ≤ contribution * totalPayout
  // (payout does not exceed the exact proportional share)
  const product = contribution * totalPayout;
  const scaledPayout = payout * totalContribution;
  assert(scaledPayout <= product, "proportional payout too large");
  // Remainder check: the "leftover" from flooring is less than totalContribution
  assert(product - scaledPayout < totalContribution, "proportional payout too small");
  return true;
}

// Pool settlement: pays out proportionally to each lender in a pool-financed
// invoice. The caller (SME) provides private contribution and payout amounts;
// the circuit proves:
//   1. sum(contribution_i) == invoiceAmount  — contributions match the invoice
//   2. Each payout_i satisfies the proportional formula via verifyProportionalPayout
//   3. The invoice is updated to FINANCED with the pool settlement marker
//
// CONTRIBUTIONS ARE PRIVATE: individual contribution amounts are never
// disclosed to the verifier — they are constrained only by the sum proof
// and proportional checks. PAYOUTS ARE PUBLIC: Compact 0.23 requires
// disclose() for any value that flows into a ledger write, even indirectly
// via persistentHash. Since payout commitments are written to the
// payoutCommitments ledger, payouts must be disclosed as public inputs.
// See docs/compact-privacy-notes.md for the full analysis.
//
// FLOOR-ROUNDING REMAINDER (→ insurance pool, modeled on Uniswap V3 fee rounding):
//   Because each payout_i is the FLOOR of (contribution_i * totalPayout / totalContribution),
//   the sum of all payouts may be strictly less than totalPayout. The difference —
//   at most 3 tNight for a 4-lender pool (each slot's floor error < 1) — is routed
//   to the shared insurance pool as a micro-fee. This is intentional and auditable:
//   the circuit PROVES the new pool balance equals the old balance plus exactly this
//   remainder, so no value is created or destroyed. The pattern mirrors Uniswap V3's
//   handling of LP fee rounding: small rounding errors accumulate in a protocol-owned
//   account rather than being silently lost or gamed.
export circuit settleSplitInvoice(
  nullifier: Bytes<32>,
  financedDueDate: Uint<64>,
  settledAt: Uint<64>,
  contribution0: Uint<64>,
  contribution1: Uint<64>,
  contribution2: Uint<64>,
  contribution3: Uint<64>,
  payout0: Uint<64>,
  payout1: Uint<64>,
  payout2: Uint<64>,
  payout3: Uint<64>,
  totalContribution: Uint<64>,
  totalPayout: Uint<64>,
  newInsurancePoolBalance: Uint<64>,
): Boolean {
  assert(invoices.member(disclose(nullifier)), "unknown invoice");
  const current = invoices.lookup(disclose(nullifier));
  assert(deriveCommitment(smeSecret(), disclose(nullifier)) == current.smeCommitment, "not the SME");
  assert(!current.lender.is_some, "already financed");
  assert(current.splitCount > 0, "not a pool invoice");

  // Sum proof: undisclosed contributions must exactly equal the invoice amount.
  assert(contribution0 + contribution1 + contribution2 + contribution3 == current.invoiceAmount, "contributions do not sum to invoice amount");

  // Proportional payout verification for all 4 lender slots.
  // Unused slots have contribution_i == 0, so payout_i must also be 0
  // (because 0 * totalContribution == payout * 0 implies payout == 0).
  // Parameters are passed as undisclosed private witnesses.
  verifyProportionalPayout(contribution0, payout0, totalContribution, totalPayout);
  verifyProportionalPayout(contribution1, payout1, totalContribution, totalPayout);
  verifyProportionalPayout(contribution2, payout2, totalContribution, totalPayout);
  verifyProportionalPayout(contribution3, payout3, totalContribution, totalPayout);

  // Floor-rounding remainder: route (totalPayout - sum(payouts)) to the insurance
  // pool. The remainder is non-negative (each payout_i ≤ floor of exact share, so
  // sum(payouts) ≤ totalPayout) and bounded to < 4 (each slot's floor error < 1).
  const sumPayouts = payout0 + payout1 + payout2 + payout3;
  const poolKey = insurancePoolKey();
  assert(insurancePools.member(poolKey), "insurance pool not seeded");
  const pool = insurancePools.lookup(poolKey);
  assert(pool.balance + (totalPayout - sumPayouts) == disclose(newInsurancePoolBalance), "insurance pool balance mismatch on remainder");
  insurancePools.insert(poolKey, InsurancePool { balance: disclose(newInsurancePoolBalance) });

  // Payout commitment: per-slot hash binding payout values to slot keys.
  // The hash is stored on-chain but doesn't reveal the payout — it only binds
  // the prover to the exact payout they proved during settlement.
  const slotKey0 = poolSlotKey(disclose(nullifier), 0);
  const slotKey1 = poolSlotKey(disclose(nullifier), 1);
  const slotKey2 = poolSlotKey(disclose(nullifier), 2);
  const slotKey3 = poolSlotKey(disclose(nullifier), 3);
  payoutCommitments.insert(slotKey0, PayoutCommitment { hash: persistentHash<PayoutSeal>(PayoutSeal { slotKey: slotKey0, payout: disclose(payout0) }) });
  payoutCommitments.insert(slotKey1, PayoutCommitment { hash: persistentHash<PayoutSeal>(PayoutSeal { slotKey: slotKey1, payout: disclose(payout1) }) });
  payoutCommitments.insert(slotKey2, PayoutCommitment { hash: persistentHash<PayoutSeal>(PayoutSeal { slotKey: slotKey2, payout: disclose(payout2) }) });
  payoutCommitments.insert(slotKey3, PayoutCommitment { hash: persistentHash<PayoutSeal>(PayoutSeal { slotKey: slotKey3, payout: disclose(payout3) }) });

  // Mark invoice as FINANCED with the pool settlement marker, per the design.
  invoices.insert(disclose(nullifier), Invoice { smeCommitment: current.smeCommitment, creditThreshold: current.creditThreshold, reputationThreshold: current.reputationThreshold, invoiceAmount: current.invoiceAmount, buyerVerified: current.buyerVerified, buyerCommitment: current.buyerCommitment, lender: some<Bytes<32>>(pad(32, "shieldledger:pool")), amount: disclose(totalPayout), dueDate: disclose(financedDueDate), rateBps: 0, claimCommitment: current.claimCommitment, transferred: current.transferred, splitCount: current.splitCount });
  invoiceCount.increment(1);
  return disclose(settledAt) <= disclose(financedDueDate);
}

// ─── Default insurance pool ──────────────────────────────────────────────────

// Fixed domain-separated key of the single shared pool entry. A pure circuit
// because Compact has no top-level constants.
export circuit insurancePoolKey(): Bytes<32> {
  return pad(32, "shieldledger:pool");
}

// Division-free percentage proof (Compact 0.23 has no division operator):
// verifies quotient == floor(total / unit) using only multiplication and
// comparison — quotient whole units fit inside total, and whatever remains is
// smaller than one unit (so the result is floored, not truncated further).
//   unit = 50 → 2% premium on registration
//   unit = 2  → 50% payout entitlement on a default claim
export circuit verifyUnitQuotient(total: Uint<64>, quotient: Uint<64>, unit: Uint<64>): Boolean {
  assert(disclose(quotient) * disclose(unit) <= disclose(total), "quota mismatch");
  assert(disclose(total) - disclose(quotient) * disclose(unit) < disclose(unit), "quota mismatch");
  return true;
}

// Pay out default insurance for a genuinely defaulted invoice.
//
// "Defaulted" means all of:
//   • the invoice exists and its auction resolved (a winning bid exists),
//   • it was never settled (no lender recorded),
//   • claimedAt is strictly past the winning bid's due date.
//
// Authorization mirrors settlement/claim transfer exactly: while the claim is
// untraded the auction leader proves their pseudonym from lenderSecret; once
// traded, the CURRENT holder re-derives the stored claimCommitment from
// claimSecret in ZK. The SME's identity — and the fact that THEY defaulted —
// never becomes public.
//
// Payout formula (strictly proven, not advisory):
//   maxEntitlement == floor(best.amount / 2)      (50% of the financed amount,
//                                                  proven via verifyUnitQuotient)
//   payout        == min(maxEntitlement, balance) — enforced by two branches:
//       fully covered  → payout must equal maxEntitlement exactly,
//       partially      → the claim must drain the pool to zero.
// An over-draining attempt also fails the dynamic underflow check inside the
// balance equality assert.
//
// Each nullifier pays at most once (insuranceClaims entry), and the new pool
// balance is passed in and proven against the old one (see InsurancePool).
export circuit claimInsurancePayout(nullifier: Bytes<32>, maxEntitlement: Uint<64>, payout: Uint<64>, newPoolBalance: Uint<64>, claimedAt: Uint<64>): Uint<64> {
  assert(invoices.member(disclose(nullifier)), "unknown invoice");
  const invoice = invoices.lookup(disclose(nullifier));
  assert(!invoice.lender.is_some, "invoice already settled");
  assert(bestBids.member(disclose(nullifier)), "auction not resolved");
  const best = bestBids.lookup(disclose(nullifier));
  assert(disclose(claimedAt) > best.dueDate, "invoice not defaulted");
  if (!invoice.transferred) {
    assert(derivePseudonym(lenderSecret()) == best.lender, "not the claim holder");
  } else {
    assert(deriveClaimCommitment(claimSecret(), disclose(nullifier)) == invoice.claimCommitment, "not the claim holder");
  }
  assert(!insuranceClaims.member(disclose(nullifier)), "payout already claimed");
  const entitlementOk = verifyUnitQuotient(best.amount, disclose(maxEntitlement), 2);
  assert(disclose(payout) <= disclose(maxEntitlement), "payout exceeds entitlement");
  const poolKey = insurancePoolKey();
  assert(insurancePools.member(poolKey), "pool not seeded");
  const pool = insurancePools.lookup(poolKey);
  assert(pool.balance - disclose(payout) == disclose(newPoolBalance), "pool balance mismatch");
  if (pool.balance >= disclose(maxEntitlement)) {
    assert(disclose(payout) == disclose(maxEntitlement), "fully covered claims must be maximal");
  } else {
    assert(disclose(newPoolBalance) == 0, "partially covered claims must drain the pool");
  }
  insurancePools.insert(poolKey, InsurancePool { balance: disclose(newPoolBalance) });
  insuranceClaims.insert(disclose(nullifier), InsuranceClaim { payout: disclose(payout), claimedAt: disclose(claimedAt) });
  invoiceCount.increment(1);
  return disclose(payout);
}

// ─── Pool secondary market: per-lender claim transfer ─────────────────────────

// Allows a single lender in a pool to privately transfer their claim slot to a
// new investor, mirroring the single-lender transferClaim circuit. Each slot
// has its own claim commitment stored in poolClaimCommitments, keyed by the
// same poolSlotKey used for pool settlements and pool bids.
//
// Authorization (two phases, same as single-lender):
//   • First hand-over (no PoolClaim entry yet): the original lender proves
//     derivePseudonym(lenderSecret()) == bestPools[slotKey].lender
//   • Later hand-overs: the current holder proves
//     deriveClaimCommitment(claimSecret(), nullifier) == stored commitment
//
// The transferred flag on PoolClaim prevents replay after atomic overwrite.
export circuit transferPoolClaim(nullifier: Bytes<32>, slotIndex: Uint<64>, newOwnerCommitment: Bytes<32>): [] {
  assert(invoices.member(disclose(nullifier)), "unknown invoice");
  const invoice = invoices.lookup(disclose(nullifier));
  assert(invoice.splitCount > 0, "not a pool invoice");
  // Allow transfer before settlement (lender not set) or after pool settlement
  // (lender == "shieldledger:pool" marker). Reject if settled to a specific lender.
  if (invoice.lender.is_some) {
    assert(invoice.lender.value == pad(32, "shieldledger:pool"), "already settled to a specific lender");
  }
  const slotKey = poolSlotKey(disclose(nullifier), disclose(slotIndex));
  assert(bestPools.member(slotKey), "pool slot not filled");

  if (!poolClaimCommitments.member(slotKey)) {
    // First hand-over: only the original lender may transfer
    assert(derivePseudonym(lenderSecret()) == bestPools.lookup(slotKey).lender, "not the claim holder");
  } else {
    assert(deriveClaimCommitment(claimSecret(), disclose(nullifier)) == poolClaimCommitments.lookup(slotKey).claimCommitment, "not the claim holder");
  }

  poolClaimCommitments.insert(slotKey, PoolClaim { claimCommitment: disclose(newOwnerCommitment), transferred: true });
  invoiceCount.increment(1);
}

// ─── Pool default insurance: per-lender proportional claim ────────────────────

// Each lender in a pool-financed invoice can independently claim their
// proportional share of the default insurance payout. The total insurance
// entitlement is floor(invoice.amount / 2), same as single-lender claims.
// Each lender's share is the floor of (settlementPayout_i * totalInsurance / invoice.amount),
// proven via the same verifyProportionalPayout pattern used in settlement.
//
// The settlementPayout is an undisclosed private witness verified against the
// on-chain payout commitment hash stored during settlement. This binds the
// insurance claim to the exact payout proved during settlement, without
// revealing individual payout amounts on-chain.
//
// Authorization mirrors transferPoolClaim: the caller proves they own the
// slot either as the original lender (lenderSecret → pseudonym match against
// bestPools) or as a secondary buyer (claimSecret → stored commitment match).
//
// Single-use: each slot can only claim once, keyed by poolSlotKey in
// insuranceClaims. When the pool is thin, the first slot to claim drains it;
// subsequent slots for the same invoice get nothing (payout forced to 0).
export circuit claimPoolInsurancePayout(nullifier: Bytes<32>, slotIndex: Uint<64>, totalInsurance: Uint<64>, insurancePayout: Uint<64>, newPoolBalance: Uint<64>, claimedAt: Uint<64>, settlementPayout: Uint<64>): Uint<64> {
  assert(invoices.member(disclose(nullifier)), "unknown invoice");
  const invoice = invoices.lookup(disclose(nullifier));
  // Pool insurance: the invoice must be pool-settled (lender == "shieldledger:pool")
  // not settled to a specific single lender.
  assert(invoice.lender.is_some, "invoice not settled");
  assert(invoice.lender.value == pad(32, "shieldledger:pool"), "not a pool-settled invoice");
  assert(invoice.splitCount > 0, "not a pool invoice");
  assert(disclose(claimedAt) > invoice.dueDate, "invoice not defaulted");

  const slotKey = poolSlotKey(disclose(nullifier), disclose(slotIndex));
  assert(bestPools.member(slotKey), "pool slot not filled");

  // Payout commitment binding: verify the claimant's settlementPayout matches
  // the on-chain commitment hash stored during settlement. This prevents a
  // malicious prover from claiming a fabricated payout amount.
  assert(payoutCommitments.member(slotKey), "pool slot not settled");
  const storedCommitment = payoutCommitments.lookup(slotKey).hash;
  const expectedCommitment = persistentHash<PayoutSeal>(PayoutSeal { slotKey: slotKey, payout: settlementPayout });
  assert(expectedCommitment == storedCommitment, "payout commitment mismatch");

  // Authorization: same two-phase check as transferPoolClaim.
  if (!poolClaimCommitments.member(slotKey)) {
    assert(derivePseudonym(lenderSecret()) == bestPools.lookup(slotKey).lender, "not the claim holder");
  } else {
    assert(deriveClaimCommitment(claimSecret(), disclose(nullifier)) == poolClaimCommitments.lookup(slotKey).claimCommitment, "not the claim holder");
  }

  // Single-use per slot.
  assert(!insuranceClaims.member(slotKey), "payout already claimed");

  // Total insurance entitlement: floor(invoice.amount / 2) via verifyUnitQuotient.
  assert(disclose(totalInsurance) * 2 <= invoice.amount, "total insurance exceeds entitlement");
  assert(invoice.amount - disclose(totalInsurance) * 2 < 2, "total insurance floor proof failed");

  // Proportional share: insurancePayout <= floor(settlementPayout * totalInsurance / invoice.amount).
  // We check only the upper bound (not exact equality) because when the insurance pool
  // is thin, a claimant may receive less than the full proportional share — the pool
  // drains to zero and later claimants get nothing. The "too small" check is omitted
  // to permit this honest partial-coverage behavior.
  assert(settlementPayout < 4294967296, "settlement payout exceeds overflow cap");
  const product = settlementPayout * disclose(totalInsurance);
  const scaledPayout = disclose(insurancePayout) * invoice.amount;
  assert(scaledPayout <= product, "insurance payout exceeds proportional share");

  // Insurance pool balance transition.
  const poolKey = insurancePoolKey();
  assert(insurancePools.member(poolKey), "pool not seeded");
  const pool = insurancePools.lookup(poolKey);
  assert(pool.balance - disclose(insurancePayout) == disclose(newPoolBalance), "pool balance mismatch");

  insurancePools.insert(poolKey, InsurancePool { balance: disclose(newPoolBalance) });
  insuranceClaims.insert(slotKey, InsuranceClaim { payout: disclose(insurancePayout), claimedAt: disclose(claimedAt) });
  invoiceCount.increment(1);
  return disclose(insurancePayout);
}
